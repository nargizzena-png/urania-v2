RewriteEngine On

# 301: pagina Servicii a fost înlocuită de Prețuri
RewriteRule ^servicii\.php$ /preturi.php [L,R=301]

# sitemap.xml generat dinamic
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Documente interne (plan, întrebări) — nu sunt publice
<FilesMatch "\.(md|sqlite|zip)$">
    Require all denied
</FilesMatch>

# llms.txt — servit ca text simplu
<Files "llms.txt">
    ForceType "text/plain; charset=utf-8"
</Files>

# Fișiere pentru agenți AI care nu există — 404 real, nu pagina HTML implicită
RewriteRule ^(\.well-known/)?ai-catalog\.json$ - [R=404,L]
