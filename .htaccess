RewriteEngine On

# 301: pagina Servicii a fost înlocuită de Prețuri
RewriteRule ^servicii\.php$ /preturi.php [L,R=301]

# sitemap.xml generat dinamic
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Documente interne (plan, întrebări) — nu sunt publice
<FilesMatch "\.(md|sqlite|zip)$">
    Require all denied
</FilesMatch>
